# Copy to .env.local and use your own values. Never commit .env.local.
DATABASE_URL=postgresql://health:change-me@127.0.0.1:54329/health_app
POSTGRES_DB=health_app
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
# Optional Neon production target, used by deployment tooling, never by the browser.
NEON_DATABASE_URL=
# Optional original database for a one-time import; leave blank for a fresh installation.
MYSQL_SOURCE_DATABASE_URL=
# Legacy MySQL container settings, only needed to retain an existing development database.
MYSQL_DATABASE=health_app
MYSQL_USER=health
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
BETTER_AUTH_URL=http://localhost:3000
# Optional extra exact origins, separated by commas, for custom deployment aliases.
APP_TRUSTED_ORIGINS=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Gemini photo analysis: server-side only. Leave blank to keep manual logging only.
GEMINI_API_KEY=
# Shared monthly application allowance in USD; automatic top-ups are never enabled by the app.
AI_MONTHLY_BUDGET_USD=1.00
# App-wide new AI requests each UTC day. Individual use is limited by credits, not a daily count.
AI_GLOBAL_DAILY_LIMIT=50

# Server setup only (Infisical): grant admin rights to this existing account. Its password is unchanged.
BOOT_ADMIN_USER=

# AI credits: 1 credit = INR 1. Welcome amount applies to new wallets on migration/signup.
AI_WELCOME_CREDITS=20
# Fixed billing conversion; review against landed provider costs. Each AI request snapshots it.
AI_CREDIT_INR_PER_USD=100
